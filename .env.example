# Copy to .env and adapt to your deployment. Never commit real credentials.
HUB_PORT=8081
HUB_BIND_ADDRESS=0.0.0.0
CONFIG_SOURCE_DIR=./configs
# Usually unnecessary: .git is read from CONFIG_SOURCE_DIR automatically.
# For a submodule/worktree, optionally set this to its actual Git metadata directory.
CONFIG_GIT_DIR=

RELAY_NAME=config-relay
RELAY_PORT=8082
RELAY_BIND_ADDRESS=0.0.0.0
# Required only when running the relay profile.
UPSTREAM_URL=http://alloy_configuration_hub:8080
RELAY_TIMEOUT=5s
RELAY_CACHE_MAX_AGE=0s
UPSTREAM_BEARER_TOKEN=

ALLOY_ID=alloy-local
ALLOY_PORT=12345
ALLOY_BIND_ADDRESS=0.0.0.0
ALLOY_CONFIG_FILE=./configs/collector/config.alloy
# To collect through the local relay, use http://alloy_config_relay:8080.
ALLOY_CONFIG_URL=http://alloy_configuration_hub:8080
ALLOY_ENV=prod
ALLOY_REMOTE=local
