// Это локальный конфиг самого Alloy: подписка на сервер.
// Атрибуты ниже сравниваются с селекторами в именах файлов:
// например, env=prod.alloy совпадёт с env ниже.
// Старые имена файлов вида "os_linux.alloy" также поддерживаются.
remotecfg {
  url            = "http://CONFIG_SERVER:8080"
  id             = constants.hostname
  poll_frequency = "30s"

  attributes = {
    env  = "prod",
    role = "web",
    os   = "linux",
  }
}
