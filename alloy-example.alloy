// Это локальный конфиг самого Alloy: подписка на сервер.
// Атрибуты ниже — то, с чем сервер сопоставляет имена файлов в ./configs:
// файл "os=linux.alloy" придёт сюда, потому что есть атрибут os = "linux".
remotecfg {
  url            = "http://CONFIG_SERVER:8080"
  id             = constants.hostname
  poll_frequency = "30s"

  attributes = {
    env  = "prod",
    role = "web",
    os   = "linux",
  }
}
