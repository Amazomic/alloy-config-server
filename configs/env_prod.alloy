
// ================= Метрики =================

prometheus.exporter.unix "host" { }

prometheus.exporter.cadvisor "local" {
  docker_host            = "unix:///var/run/docker.sock"
  storage_duration       = "2m"
  store_container_labels = true
}

prometheus.scrape "metrics" {
  targets = concat(
    [{__address__ = "localhost:12345"}],
    prometheus.exporter.unix.host.targets,
    prometheus.exporter.cadvisor.local.targets,
  )
  forward_to = [prometheus.relabel.local.receiver]
}

prometheus.relabel "local" {
  forward_to = [
    otelcol.receiver.prometheus.metrics_in.receiver,
  ]

  rule {
    source_labels = ["__address__"]
    target_label  = "instance"
    replacement   = "{{id}}"
  }
  rule {
    target_label = "job"
    replacement  = "prod_metrics"
  }
}

otelcol.receiver.prometheus "metrics_in" {
  output {
    metrics = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.otlphttp.otlp_out.input]
  }
}

// ================= Логи =================

discovery.docker "docker_logs" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.docker_logs.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  rule {
    target_label = "host"
    replacement  = "{{id}}"
  }
}

loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_logs.output
  labels     = {}
  forward_to = [loki.process.multiline.receiver]
}

loki.process "multiline" {
  forward_to = [otelcol.receiver.loki.logs_in.receiver]

  stage.multiline {
    firstline     = "(?i)^(warn|info|error|unk)"
    max_wait_time = "5s"
  }
}

otelcol.receiver.loki "logs_in" {
  output {
    logs = [otelcol.processor.transform.to_resource.input]
  }
}

otelcol.processor.transform "to_resource" {
  error_mode = "ignore"

  log_statements {
    context = "log"
    statements = [
      `set(resource.attributes["container_name"], attributes["container_name"])`,
      `set(resource.attributes["host"], attributes["host"])`,
      `set(resource.attributes["service.name"], attributes["container_name"])`,
    ]
  }

  output {
    logs = [otelcol.processor.batch.logs_default.input]
  }
}

otelcol.processor.batch "logs_default" {
  output {
    logs = [otelcol.exporter.otlphttp.otlp_out.input]
  }
}